# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database (used by docker-compose.yml and the backend) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=online_menu
DB_USERNAME=online_menu
DB_PASSWORD=online_menu

# --- JWT ---
# Generate a long random value, e.g.: openssl rand -base64 64
JWT_SECRET=change-this-to-a-long-random-secret-before-deploying-to-production
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Google OAuth2 ---
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email verification (SMTP) ---
# Without MAIL_HOST the verification code and link are only written to the backend log (local development).
# Gmail example: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, an app password as MAIL_PASSWORD.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Frontend page the emailed link opens
EMAIL_VERIFICATION_URL=http://localhost:4200/auth/verify-email
# Frontend page the emailed password reset link opens
PASSWORD_RESET_URL=http://localhost:4200/auth/reset-password

# --- Telegram login ---
# Create a bot with @BotFather, then /setdomain to the domain the frontend is served from
# (the Login Widget does not work on plain localhost; use a tunnel such as ngrok for local tests).
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=

# --- CORS / Frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:4200
OAUTH2_REDIRECT_URI=http://localhost:4200/auth/google/callback

# --- File uploads ---
UPLOAD_BASE_DIR=./uploads

SERVER_PORT=8080
LOG_LEVEL=INFO

# --- Billing / payments ---
# Panel page users return to after paying, and the public address of this backend
# (payment systems call <PAYMENT_CALLBACK_BASE_URL>/api/v1/public/payments/<payme|click|uzum|lemonsqueezy>).
BILLING_RETURN_URL=http://localhost:4200/billing
PAYMENT_CALLBACK_BASE_URL=http://localhost:8080
# Payme (Paycom): merchant cabinet -> cashbox id and key. Test: PAYME_CHECKOUT_URL=https://test.paycom.uz
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
# Click: merchant cabinet -> service
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
# Uzum Bank merchant API (Basic auth credentials Uzum gives you)
UZUM_SERVICE_ID=
UZUM_LOGIN=
UZUM_PASSWORD=
# Lemon Squeezy: card payments for users outside Uzbekistan (USD, EUR). A store charges in one currency,
# so create one store + product variant per currency. Settings -> API for the key; Settings -> Webhooks:
# URL <PAYMENT_CALLBACK_BASE_URL>/api/v1/public/payments/lemonsqueezy, event order_created, signing secret.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_SIGNING_SECRET=
LEMONSQUEEZY_STORE_ID_USD=
LEMONSQUEEZY_VARIANT_ID_USD=
LEMONSQUEEZY_STORE_ID_EUR=
LEMONSQUEEZY_VARIANT_ID_EUR=
# Development only: a fake provider that marks orders paid at once
PAYMENT_SANDBOX_ENABLED=false
