<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

  <changeSet id="003-create-cafe-table" author="online-menu">
    <createTable tableName="cafe">
      <column name="id" type="UUID">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="slug" type="VARCHAR(180)">
        <constraints nullable="false" unique="true" uniqueConstraintName="uk_cafe_slug"/>
      </column>
      <column name="name_translations" type="JSONB">
        <constraints nullable="false"/>
      </column>
      <column name="description_translations" type="JSONB"/>
      <column name="logo_url" type="VARCHAR(500)"/>
      <column name="cover_url" type="VARCHAR(500)"/>
      <column name="phone" type="VARCHAR(50)"/>
      <column name="address" type="VARCHAR(500)"/>
      <column name="active" type="BOOLEAN" defaultValueBoolean="true">
        <constraints nullable="false"/>
      </column>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
      <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(200)"/>
      <column name="updated_by" type="VARCHAR(200)"/>
    </createTable>
  </changeSet>

</databaseChangeLog>
