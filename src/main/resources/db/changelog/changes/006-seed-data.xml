<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

  <changeSet id="006-seed-languages" author="online-menu">
    <insert tableName="language">
      <column name="id" valueComputed="gen_random_uuid()"/>
      <column name="code" value="uz"/>
      <column name="name" value="Uzbek"/>
      <column name="native_name" value="O&apos;zbekcha"/>
      <column name="is_default" valueBoolean="true"/>
      <column name="is_active" valueBoolean="true"/>
      <column name="sort_order" valueNumeric="1"/>
    </insert>
    <insert tableName="language">
      <column name="id" valueComputed="gen_random_uuid()"/>
      <column name="code" value="en"/>
      <column name="name" value="English"/>
      <column name="native_name" value="English"/>
      <column name="is_default" valueBoolean="false"/>
      <column name="is_active" valueBoolean="true"/>
      <column name="sort_order" valueNumeric="2"/>
    </insert>
    <insert tableName="language">
      <column name="id" valueComputed="gen_random_uuid()"/>
      <column name="code" value="ru"/>
      <column name="name" value="Russian"/>
      <column name="native_name" value="Русский"/>
      <column name="is_default" valueBoolean="false"/>
      <column name="is_active" valueBoolean="true"/>
      <column name="sort_order" valueNumeric="3"/>
    </insert>
  </changeSet>

