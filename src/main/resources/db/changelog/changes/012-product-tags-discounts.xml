<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

  <changeSet id="012-add-product-tags" author="online-menu">
    <addColumn tableName="product">
      <column name="tags" type="JSONB" defaultValueComputed="'[]'::jsonb">
        <constraints nullable="false"/>
      </column>
    </addColumn>
  </changeSet>

  <changeSet id="012-create-discount-table" author="online-menu">
    <createTable tableName="discount">
      <column name="id" type="UUID">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="slug" type="VARCHAR(180)">
        <constraints nullable="false" unique="true" uniqueConstraintName="uk_discount_slug"/>
      </column>
      <column name="cafe_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="product_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="discount_price" type="NUMERIC(12,2)">
        <constraints nullable="false"/>
      </column>
      <column name="starts_at" type="TIMESTAMP WITH TIME ZONE"/>
      <column name="ends_at" type="TIMESTAMP WITH TIME ZONE"/>
      <column name="active" type="BOOLEAN" defaultValueBoolean="true">
        <constraints nullable="false"/>
      </column>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
      <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(200)"/>
      <column name="updated_by" type="VARCHAR(200)"/>
    </createTable>
    <addForeignKeyConstraint baseTableName="discount" baseColumnNames="cafe_id"
      constraintName="fk_discount_cafe"
      referencedTableName="cafe" referencedColumnNames="id"
      onDelete="CASCADE"/>
    <addForeignKeyConstraint baseTableName="discount" baseColumnNames="product_id"
      constraintName="fk_discount_product"
      referencedTableName="product" referencedColumnNames="id"
      onDelete="CASCADE"/>
    <createIndex tableName="discount" indexName="idx_discount_cafe">
      <column name="cafe_id"/>
    </createIndex>
    <createIndex tableName="discount" indexName="idx_discount_product">
      <column name="product_id"/>
    </createIndex>
  </changeSet>

  <changeSet id="012-seed-messages" author="online-menu">
    <insert tableName="system_message">
      <column name="id" valueComputed="gen_random_uuid()"/>
      <column name="code" value="error.discount.not_found"/>
      <column name="translations"
        value='{"uz": "Chegirma topilmadi", "en": "Discount not found", "ru": "Скидка не найдена"}'/>
    </insert>
    <insert tableName="system_message">
      <column name="id" valueComputed="gen_random_uuid()"/>
      <column name="code" value="error.discount.price_invalid"/>
      <column name="translations"
        value='{"uz": "Chegirma narxi taomning asl narxidan kichik bo&apos;lishi kerak", "en": "The discount price must be lower than the regular price", "ru": "Цена со скидкой должна быть ниже обычной цены"}'/>
    </insert>
    <insert tableName="system_message">
      <column name="id" valueComputed="gen_random_uuid()"/>
      <column name="code" value="error.discount.period_invalid"/>
      <column name="translations"
        value='{"uz": "Tugash vaqti boshlanish vaqtidan keyin bo&apos;lishi kerak", "en": "The end must be after the start", "ru": "Окончание должно быть позже начала"}'/>
    </insert>
    <insert tableName="system_message">
      <column name="id" valueComputed="gen_random_uuid()"/>
      <column name="code" value="error.discount.overlap"/>
      <column name="translations"
        value='{"uz": "Bu taomda shu davrga to&apos;g&apos;ri keladigan boshqa faol chegirma bor", "en": "This product already has an active discount in that period", "ru": "У этого блюда уже есть активная скидка в этот период"}'/>
    </insert>
    <insert tableName="system_message">
      <column name="id" valueComputed="gen_random_uuid()"/>
      <column name="code" value="error.profile.password_invalid"/>
      <column name="translations"
        value='{"uz": "Joriy parol noto&apos;g&apos;ri", "en": "The current password is incorrect", "ru": "Текущий пароль неверен"}'/>
    </insert>
  </changeSet>

  <changeSet id="012-seed-menu-ui-tag-messages" author="online-menu">
    <insert tableName="system_message">
      <column name="id" valueComputed="gen_random_uuid()"/>
      <column name="code" value="menu.ui.tag_new"/>
      <column name="translations" value='{"uz": "Yangi", "en": "New", "ru": "Новинка"}'/>
    </insert>
    <insert tableName="system_message">
      <column name="id" valueComputed="gen_random_uuid()"/>
      <column name="code" value="menu.ui.tag_hit"/>
      <column name="translations" value='{"uz": "Hit", "en": "Bestseller", "ru": "Хит"}'/>
    </insert>
    <insert tableName="system_message">
      <column name="id" valueComputed="gen_random_uuid()"/>
      <column name="code" value="menu.ui.tag_spicy"/>
      <column name="translations" value='{"uz": "Achchiq", "en": "Spicy", "ru": "Острое"}'/>
    </insert>
  </changeSet>

</databaseChangeLog>
